{
  "schema": 1,
  "repository": "4alvit/energy-data-rag-pipeline",
  "mode": "release",
  "default_branch": "main",
  "validation_workflows": [
    "ci.yml",
    "codeql.yml",
    "release-security.yml",
    "dependency-review.yml",
    "native-validation.yml"
  ],
  "artifact_pattern": "release-assets*",
  "version_file": "version",
  "local_checks": [
    "bash scripts/ci.sh",
    "bash scripts/ci.sh security"
  ],
  "notes": [
    "Integration tests require PostgreSQL with pgvector: local ci.sh provisions a disposable container; CI provisions a matching energy_rag_test service.",
    "FCC preserves its pinned upstream source commit and uses hash-locked runtime and build dependencies with targeted advisory fixes. Both OCI images preserve amd64 and arm64 builds."
  ],
  "container_assets": {
    "energy-data-rag-pipeline-container.oci.tar": "ghcr.io/4alvit/energy-data-rag-pipeline",
    "energy-rag-fcc-container.oci.tar": "ghcr.io/4alvit/free-claude-code"
  },
  "visibility": "public",
  "single_entry_ci": true,
  "release_notes": "CHANGELOG.md",
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "files": [
      {
        "path": "version",
        "format": "text",
        "value": "package"
      },
      {
        "path": "pyproject.toml",
        "format": "toml",
        "field": "project.version",
        "package": "energy-rag-pipeline",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "uv.lock",
        "format": "uv-lock",
        "package": "energy-rag-pipeline",
        "value": "package",
        "ecosystem": "pep440"
      }
    ],
    "artifacts": [
      {
        "path": "energy-data-rag-pipeline-*.tar.gz",
        "format": "tar-toml",
        "member": "energy-data-rag-pipeline/pyproject.toml",
        "field": "project.version",
        "package": "energy-rag-pipeline",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "energy-data-rag-pipeline-*.tar.gz",
        "format": "tar-text",
        "member": "energy-data-rag-pipeline/version",
        "value": "package"
      },
      {
        "path": "energy-data-rag-pipeline-container.oci.tar",
        "format": "oci",
        "field": [
          "config",
          "Labels",
          "org.opencontainers.image.version"
        ],
        "value": "package"
      },
      {
        "path": "energy-rag-fcc-container.oci.tar",
        "format": "oci",
        "field": [
          "config",
          "Labels",
          "org.opencontainers.image.version"
        ],
        "value": "package"
      }
    ],
    "toolkit_revision": "5e413f80a4353d328b4529eae57992ac3987e2dd"
  },
  "fuzzing": {
    "toolkit_ref": "dff3879fcdaf0d0eeb0145e50f7f034ab2e87b93"
  }
}

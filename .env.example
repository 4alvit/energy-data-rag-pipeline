# Database (must be a full literal URL - docker compose does not interpolate
# variables between entries of this file)
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://rag:changeme@localhost:5432/energy_rag

# Ports (docker compose)
API_PORT=8000
MCP_PORT=8800

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM Provider: ollama, openai, anthropic
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
# Optional client base-URL override (openai/anthropic only). Example:
# point the anthropic provider at a local Free Claude Code proxy so /query
# generates answers through FCC's free providers:
#   LLM_PROVIDER=anthropic
#   LLM_BASE_URL=http://localhost:8082
#   LLM_MODEL=nvidia_nim/nvidia/nemotron-3-super-120b-a12b
#   ANTHROPIC_API_KEY=freecc   # or your FCC proxy auth token
LLM_BASE_URL=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI (if using)
OPENAI_API_KEY=

# Anthropic (if using)
ANTHROPIC_API_KEY=

# Logging
LOG_LEVEL=INFO

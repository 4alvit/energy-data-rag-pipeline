#!/usr/bin/env bash
# Deploy the Energy RAG stack to a Synology NAS over SSH.
#
# Setup (one-time):
#   1. cp deploy/deploy.sh.example deploy/deploy.sh   # deploy.sh is gitignored
#   2. Edit the configuration block below or export overrides.
#   3. Ensure `ssh synology whoami` and `ssh synology 'sudo -n true'` both work.
#
# Usage:
#   deploy/deploy.sh                  # sync config + pull images + restart stack
#   deploy/deploy.sh --with-docs      # also upload & ingest the RAG docs corpus
#   deploy/deploy.sh status           # show container status
#   deploy/deploy.sh logs [service]   # tail logs (api|mcp|postgres)
#   deploy/deploy.sh down             # stop the stack

set -euo pipefail

# ---------------------------------------------------------------------------
# Configuration (override via environment variables)
# ---------------------------------------------------------------------------
SYNOLOGY_HOST="${SYNOLOGY_HOST:-synology}"                       # ssh alias/host
SYNOLOGY_USER="${SYNOLOGY_USER:-}"                               # empty = ssh alias default
REMOTE_DIR="${REMOTE_DIR:-/volume1/docker/energy-rag}"          # deployment root on NAS
DATA_ROOT="${DATA_ROOT:-${REMOTE_DIR}}"                         # volume parent on NAS
TAG="${TAG:-$(cat "$(dirname "$0")/../version" 2>/dev/null || echo latest)}"
API_PORT="${API_PORT:-8000}"
MCP_PORT="${MCP_PORT:-8800}"
FCC_PORT="${FCC_PORT:-8082}"
POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-changeme}"              # CHANGE ME in deploy.sh
OLLAMA_BASE_URL="${OLLAMA_BASE_URL:-http://192.168.1.50:11434}"
LOG_LEVEL="${LOG_LEVEL:-INFO}"
# Optional headless FCC provisioning (empty = configure via Admin UI later)
NVIDIA_NIM_API_KEY="${NVIDIA_NIM_API_KEY:-}"
FCC_MODEL="${FCC_MODEL:-nvidia_nim/nvidia/nemotron-3-super-120b-a12b}"

SSH_TARGET="${SYNOLOGY_HOST}"
[ -n "$SYNOLOGY_USER" ] && SSH_TARGET="${SYNOLOGY_USER}@${SYNOLOGY_HOST}"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"

# Synology's non-interactive sudo truncates PATH to /usr/bin:/bin:/usr/sbin:/sbin
# while Container Manager lives in /usr/local/bin - restore it for every
# remote sudo invocation.
REMOTE_SUDO_ENV="PATH=/usr/local/bin:/usr/bin:/bin"

# Prefer the compose plugin; fall back to standalone docker-compose.
if ssh -o BatchMode=yes "$SSH_TARGET" "sudo env $REMOTE_SUDO_ENV docker compose version >/dev/null 2>&1"; then
  COMPOSE="docker compose"
else
  COMPOSE="docker-compose"
fi

log() { printf '\033[1;34m[deploy]\033[0m %s\n' "$*"; }
die() { printf '\033[1;31m[deploy] ERROR:\033[0m %s\n' "$*" >&2; exit 1; }

remote() { ssh "$SSH_TARGET" "$@"; }

preflight() {
  command -v rsync >/dev/null || die "rsync not found locally"
  ssh -o BatchMode=yes -o ConnectTimeout=5 "$SSH_TARGET" true \
    || die "passwordless ssh to '$SSH_TARGET' failed"
  remote 'sudo -n true 2>/dev/null' || die "passwordless sudo on '$SSH_TARGET' failed"
  log "Preflight OK: $SSH_TARGET -> $REMOTE_DIR (tag $TAG)"
}

sync_files() {
  log "Uploading deployment files..."
  ssh "$SSH_TARGET" "sudo mkdir -p '$REMOTE_DIR/sql' '$DATA_ROOT/data'"
  rsync -az --delete "$REPO_DIR/deploy/docker-compose.prod.yml" \
    "$SSH_TARGET:$REMOTE_DIR/docker-compose.prod.yml"
  rsync -az --delete "$REPO_DIR/sql/init.sql" \
    "$SSH_TARGET:$REMOTE_DIR/sql/init.sql"

  # Write .env only if absent so operator tweaks survive redeploys.
  remote "test -f '$REMOTE_DIR/.env'" || write_env
}

write_env() {
  log "Creating remote .env"
  remote "sudo tee '$REMOTE_DIR/.env' >/dev/null" <<EOF
TAG=$TAG
DATA_ROOT=$DATA_ROOT
API_PORT=$API_PORT
MCP_PORT=$MCP_PORT
FCC_PORT=$FCC_PORT
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
OLLAMA_BASE_URL=$OLLAMA_BASE_URL
LOG_LEVEL=$LOG_LEVEL
EMBEDDING_MODEL=${EMBEDDING_MODEL:-sentence-transformers/all-MiniLM-L6-v2}
LLM_PROVIDER=${LLM_PROVIDER:-ollama}
LLM_MODEL=${LLM_MODEL:-llama3.1:8b}
NVIDIA_NIM_API_KEY=$NVIDIA_NIM_API_KEY
FCC_MODEL=$FCC_MODEL
EOF
}

compose_cmd() {
  remote "cd '$REMOTE_DIR' && sudo env $REMOTE_SUDO_ENV $COMPOSE -f docker-compose.prod.yml $*"
}

deploy_stack() {
  sync_files
  log "Pulling multi-arch images (this can take a while on first run)..."
  compose_cmd "pull --quiet"
  log "Starting stack..."
  compose_cmd "up -d --remove-orphans"
  wait_healthy
  smoke_test
}

wait_healthy() {
  log "Waiting for API health..."
  for _attempt in $(seq 1 60); do
    if remote "curl -fsS http://localhost:${API_PORT}/health >/dev/null 2>&1"; then
      log "API is healthy."
      return 0
    fi
    sleep 5
  done
  die "API did not become healthy in time. Check: deploy/deploy.sh logs api"
}

smoke_test() {
  log "Smoke test query..."
  remote "curl -fsS -X POST http://localhost:${API_PORT}/query \
    -H 'Content-Type: application/json' \
    -d '{\"query\":\"health\",\"top_k\":1}' | head -c 300" \
    || log "Query returned an error (empty index is OK right after first deploy)."
}

upload_docs_corpus() {
  log "Uploading RAG docs corpus..."
  if [ ! -d "$REPO_DIR/docs-corpus" ]; then
    log "No docs-corpus/ found - generating it now."
    "$REPO_DIR/scripts/export_docs_corpus.py"
  fi
  rsync -az --delete "$REPO_DIR/docs-corpus/" \
    "$SSH_TARGET:$DATA_ROOT/data/docs-corpus/"
  log "Triggering ingestion of /data/docs-corpus inside api container..."
  if remote "curl -fsS -X POST http://localhost:${API_PORT}/ingest \
    -H 'Content-Type: application/json' \
    -d '{\"source_type\":\"forum_json\",\"paths\":[\"/data/docs-corpus/corpus.json\"],\"chunk_strategy\":\"recursive\"}'"; then
    log "Ingestion queued."
  else
    die "Ingestion request failed."
  fi
}

case "${1:-deploy}" in
  deploy)
    preflight
    deploy_stack
    ;;
  --with-docs)
    preflight
    deploy_stack
    upload_docs_corpus
    ;;
  status)  compose_cmd "ps" ;;
  logs)    compose_cmd "logs -f --tail=100 ${2:-}" ;;
  restart) compose_cmd "restart" ;;
  pull)    compose_cmd "pull" ;;
  down)    compose_cmd "down" ;;
  *)
    echo "Usage: $0 [deploy|--with-docs|status|logs [svc]|restart|pull|down]"
    exit 1
    ;;
esac
